# EditorConfig (DEV-14.1, DEV-14.2): https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# The front end, the nginx files and the shell scripts keep four spaces
# (a deviation of DEV-14.2 and DEV-15.1, listed in CLAUDE.md).
[*.{js,css,html,sh,conf,template}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
