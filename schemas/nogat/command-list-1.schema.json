{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Nogat/schemas/agent/command-list-1.schema.json",
  "title": "<tool>-command-list/1",
  "description": "Summary of the command catalog (AGI-2.4): one entry per command, the first step of discovery; the full command is <tool>-commands/1. Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": ["schema", "tool", "version", "commands"],
  "properties": {
    "schema": {"type": "string", "pattern": "^[a-z][a-z0-9]*-command-list/1$"},
    "tool": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
    "version": {"type": "string", "minLength": 1},
    "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["name", "operation_id", "summary", "read_only"],
      "properties": {
        "name": {"$ref": "commands-1.schema.json#/$defs/command_name"},
        "operation_id": {
          "description": "`<tool>_<group>_<verb>`, as in <tool>-commands/1 (AGI-5.2)",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9]+_[a-z0-9_]+$",
          "maxLength": 48
        },
        "summary": {"type": "string", "minLength": 1},
        "read_only": {"type": "boolean"},
        "effects": {
          "$ref": "commands-1.schema.json#/$defs/effects",
          "description": "The command's effects as in <tool>-commands/1, its `read_only` equal to the entry's"
        },
        "check": {"$ref": "commands-1.schema.json#/$defs/check"},
        "rest": {
          "$ref": "commands-1.schema.json#/$defs/rest",
          "description": "How the server that answers this list serves the command (AGI-6.8): its route and whether a run needs the tool's key, read by a proxy such as Latarnik at `/api/v1/commands/list`"
        }
      }
    }
  }
}
