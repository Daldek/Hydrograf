{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daldek/Nogat/schemas/agent/commands-1.schema.json",
  "title": "<tool>-commands/1",
  "description": "Command catalog (AGI §2). Unknown fields are allowed: adding optional fields keeps the version (AGI-4.1).",
  "type": "object",
  "required": ["schema", "tool", "version", "commands"],
  "properties": {
    "schema": {"type": "string", "pattern": "^[a-z][a-z0-9]*-commands/1$"},
    "tool": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
    "version": {"type": "string", "minLength": 1},
    "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}}
  },
  "$defs": {
    "command_name": {
      "description": "`<group> <verb>` as typed in the CLI; `server` and `jobs` are reserved and never a group (AGI-6.1)",
      "type": "string",
      "pattern": "^(?!(server|jobs) )[a-z][a-z0-9-]* [a-z][a-z0-9-]*$"
    },
    "effects": {
      "type": "object",
      "required": ["read_only", "writes", "idempotent", "network", "destructive"],
      "properties": {
        "read_only": {"type": "boolean"},
        "writes": {"enum": ["none", "add", "replace", "delete"]},
        "idempotent": {"type": "boolean"},
        "network": {"type": "boolean"},
        "destructive": {"type": "boolean"}
      },
      "if": {"properties": {"read_only": {"const": true}}},
      "then": {"properties": {"writes": {"const": "none"}, "destructive": {"const": false}}}
    },
    "check": {
      "description": "name of the command that plans this one without effects, or null",
      "oneOf": [{"$ref": "#/$defs/command_name"}, {"type": "null"}]
    },
    "rest": {
      "description": "The command's route on the tool's server (AGI-6.1, AGI-6.8), or null where the server does not serve it. `key`: true when a run needs the tool's key `X-API-Key`, because it changes something on the server or the tool keeps it for its operator; absent, true for a command whose effects are not read-only and false otherwise. Other fields, such as Obserwator's `server_options` and `local_options`, are allowed",
      "oneOf": [
        {
          "type": "object",
          "required": ["method", "path"],
          "properties": {
            "method": {
              "description": "`GET` for a read-only command; `POST` for a writing one and for a read-only one whose inputs a URL cannot carry",
              "enum": ["GET", "POST"]
            },
            "path": {
              "description": "The route on the tool's own server, `/api/v1/<group>/<verb>`",
              "type": "string",
              "pattern": "^/api/v[1-9][0-9]*/(?!(server|jobs)/)[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
            },
            "key": {"type": "boolean"}
          }
        },
        {"type": "null"}
      ]
    },
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "command": {
      "type": "object",
      "required": [
        "name", "operation_id", "function", "summary", "description", "options",
        "result", "effects", "check", "rules", "examples", "errors", "i18n"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/command_name"},
        "operation_id": {
          "description": "`<tool>_<group>_<verb>`; MCP tool name and OpenAPI operationId (AGI-5.2)",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_[a-z0-9]+_[a-z0-9_]+$",
          "maxLength": 48
        },
        "function": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
        "summary": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}},
        "result": {
          "type": "object",
          "required": ["schema", "cardinality"],
          "properties": {
            "schema": {"type": "string", "pattern": "^[a-z][a-z0-9]*-[a-z0-9-]+/[1-9][0-9]*$"},
            "cardinality": {"enum": ["single", "bounded", "unbounded"]}
          }
        },
        "effects": {"$ref": "#/$defs/effects"},
        "check": {"$ref": "#/$defs/check"},
        "rest": {"$ref": "#/$defs/rest"},
        "long": {
          "description": "True when a run can outlast a request: the server serves it as a job, `nogat-job/1` (AGI-6.10); absent means false",
          "type": "boolean"
        },
        "families": {
          "description": "MCP tool families selectable with --tools (AGI-5.8); `core` marks the core family (AGI-5.12)",
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "one_of": {
          "description": "Alternatives, each a list of option names, of which exactly one is given completely (AGI-2.3); a form offers them as one choice",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/identifier"},
            "uniqueItems": true
          }
        },
        "rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["call", "result"],
            "properties": {
              "call": {"type": "string", "minLength": 1, "description": "complete CLI call"},
              "result": {"description": "excerpt of the expected result"}
            }
          }
        },
        "errors": {
          "type": "array",
          "items": {"$ref": "error-1.schema.json#/$defs/code"},
          "uniqueItems": true
        },
        "i18n": {
          "type": "object",
          "required": ["pl"],
          "properties": {
            "pl": {
              "type": "object",
              "properties": {
                "summary": {"type": "string"},
                "description": {"type": "string"},
                "rules": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "option": {
      "type": "object",
      "required": ["name", "type", "required", "description"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "type": {"enum": ["string", "integer", "number", "boolean", "array", "object"]},
        "unit": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "default": {},
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value", "meaning"],
            "properties": {"value": {}, "meaning": {"type": "string", "minLength": 1}}
          }
        },
        "min": {"type": "number"},
        "max": {"type": "number"},
        "exclusive_minimum": {"type": "number"},
        "exclusive_maximum": {"type": "number"},
        "pattern": {"type": "string"},
        "items": {
          "description": "The items of an array: their type, or a JSON Schema of them",
          "anyOf": [
            {"enum": ["string", "integer", "number", "boolean", "object"]},
            {"type": "object"}
          ]
        },
        "format": {
          "description": "The form of a string value, a JSON Schema format: `date`, `date-time`",
          "type": "string",
          "minLength": 1
        },
        "examples": {"type": "array"},
        "description": {"type": "string", "minLength": 1},
        "one_of": {
          "$ref": "#/$defs/identifier",
          "description": "Mutual exclusion group: at most one of its options is given, exactly one where the command's `one_of` holds them"
        },
        "path_role": {"enum": ["input", "output", "root"]},
        "section": {
          "description": "The title, in English, of the group of options the option belongs to in a form and in the help",
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "description": "The options a call that gives this one also gives",
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "excludes": {
          "description": "The options a call that gives this one does not give",
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "applies_to": {
          "$ref": "#/$defs/condition",
          "description": "Where the option applies; elsewhere a form does not show it"
        },
        "required_when": {
          "$ref": "#/$defs/condition",
          "description": "Where the option is required"
        },
        "i18n": {
          "type": "object",
          "properties": {
            "pl": {
              "type": "object",
              "properties": {
                "description": {"type": "string"},
                "section": {"type": "string"},
                "enum": {
                  "description": "The meaning of each value of `enum`, by the value as text",
                  "type": "object",
                  "additionalProperties": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "condition": {
      "description": "Option names, each with `true` (the option is given) or the values it may have; every entry holds",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {
        "oneOf": [{"const": true}, {"type": "array", "minItems": 1}]
      }
    }
  }
}
