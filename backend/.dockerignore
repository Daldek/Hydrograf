# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual environment
.venv/

# Environment files (secrets)
.env
.env.*

# Git
.git/
.gitignore

# Tests (not needed in production image)
tests/

# Dev tools cache
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Documentation (not needed in image)
*.md

# pyproject.toml and uv.lock stay in the context: the builder installs the lock and
# core/version.py reads the version from pyproject.toml at run time.
