# Hydrograf Pipeline Configuration
# Copy to config.yaml and adjust values. Every key below is read by the pipeline; the
# database comes from the environment (.env.example), not from this file.

# DEM Processing
dem:
  # BDOT10k streams burned into the DEM (bootstrap step 3):
  #   all  - every line of OT_SWRS_L, OT_SWKN_L and OT_SWRM_L
  #   main - OT_SWRS_L main courses (PRZEBIEG 'ciek główny') that are rivers or carry
  #          an MPHP identifier, OT_SWKN_L with an MPHP identifier, no OT_SWRM_L
  # Water bodies (OT_PTWP_A) are burned in both; bdot_streams and the lake
  # classification always use every layer.
  stream_burning: all
  # Nodata areas that the DEM data encloses (a sheet missing from the mosaic):
  #   false - an outlet: the depression fill drains the land around them into them
  #           (endorheic areas)
  #   true  - interpolated from the data around them before the fill: only the outer
  #           edge of the data drains the area; the DEM (01_dem) holds the values
  fill_enclosed_nodata: false

# Soil groups (bootstrap step 5)
soil:
  # The SoilGrids layers whose hydrologic soil groups (HSG) Kartograf computes (ADR-079):
  #   least-permeable - per cell the group of the least permeable layer of 0-100 cm
  #                     (store segment hsg/global_soilgrids_0-100cm_least-permeable_mean)
  #   topsoil         - the group of the 0-5 cm layer, the rule before ADR-079
  #                     (hsg/global_soilgrids_0-5cm_mean)
  # A run from a set needs the HSG raster of this segment among its pins.
  hsg_depth_rule: least-permeable

# Paths (relative to project root)
paths:
  cache_dir: "cache"          # raw downloaded data (NMT, BDOT10k, HSG)
